    "execute": [
      {
        "description": "Create function \"set_updated_at\"",
        "sql": "CREATE OR REPLACE FUNCTION \"public\".\"set_updated_at\"() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  NEW.\"updatedAt\" = now();\n  RETURN NEW;\nEND;\n$$"
