    "execute": [
      {
        "description": "create table \"order\"",
        "sql": "CREATE TABLE \"public\".\"order\" (\n  \"cancelledAt\" timestamptz,\n  \"cancelledBy\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"customerEmail\" text NOT NULL,\n  \"customerName\" text DEFAULT '' NOT NULL,\n  \"deliveredAt\" timestamptz,\n  \"deliveryAddress\" text NOT NULL,\n  \"deliveryName\" text NOT NULL,\n  \"discountAmount\" int4 DEFAULT 0 NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"orderStatus\" text DEFAULT 'pending_payment' NOT NULL,\n  \"paidAt\" timestamptz,\n  \"paymentId\" text DEFAULT '' NOT NULL,\n  \"paymentStatus\" text DEFAULT 'pending' NOT NULL,\n  \"promoCode\" text DEFAULT '' NOT NULL,\n  \"razorpayOrderId\" text NOT NULL,\n  \"returnedAt\" timestamptz,\n  \"shippedAt\" timestamptz,\n  \"totalAmount\" float8 NOT NULL,\n  \"totalItems\" int4 NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"userId\" uuid NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"order_cancelledBy_check_2cc69f64\" CHECK (\"cancelledBy\" IN ('customer', 'admin')),\n  CONSTRAINT \"order_discount_amount_min_f2689c28\" CHECK (\"discountAmount\" >= 0),\n  CONSTRAINT \"order_orderStatus_check_a252a221\" CHECK (\"orderStatus\" IN ('pending_payment', 'placed', 'shipped', 'delivered', 'returned', 'cancelled')),\n  CONSTRAINT \"order_paymentStatus_check_ad13dc0d\" CHECK (\"paymentStatus\" IN ('pending', 'paid', 'failed')),\n  CONSTRAINT \"order_promo_code_uppercase_fafa66df\" CHECK (\"promoCode\" = upper(btrim(\"promoCode\"))),\n  CONSTRAINT \"order_total_amount_min_a0230a06\" CHECK (\"totalAmount\" >= 0),\n  CONSTRAINT \"order_total_item_min_f8d723e1\" CHECK (\"totalItems\" >= 1)\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"order\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"order\""
        ]
      }
    ]
  },
