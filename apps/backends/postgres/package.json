{
  "name": "postgres-service",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:test": "tsx src/scripts/test-connection.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma contract emit && prisma migration plan --name",
    "db:apply": "pnpm run db:sql && prisma db migrate && prisma db sign",
    "db:sql": "tsx src/scripts/write-migration-sql.ts"
  },
  "keywords": [],
