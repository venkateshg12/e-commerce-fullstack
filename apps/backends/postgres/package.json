    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.20.4",
    "@types/proxy-addr": "^2.0.3",
    "@types/streamifier": "^0.1.2",
    "prisma": "8.0.0-rc.15",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  },
