PORT=5000
CORS_ORIGIN=http://localhost:5173
MONGO_URI=mongodb+srv://your_db_user:your_password@your-cluster.mongodb.net/your_database
# Two DIFFERENT random secrets of at least 32 characters each; the server refuses to start otherwise.
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
SMTP_HOST= smtp.gmail.com               # No need to change
SMTP_PORT=587                           # No need to change
SMTP_USER=youradmin@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM="your_website_name <youradmin@gmail.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NODE_ENV=development

# Proxies in front of this app whose client-IP headers (X-Forwarded-For, cf-connecting-ip)
# may be believed, as comma-separated IPv4/IPv6 CIDRs. Express and the rate limiter both use this
# list. It must name the machine that opens the TCP connection to this app, and nothing else.
#   - Behind a load balancer or reverse proxy (nginx, Render, Railway, an ALB...), list ITS address
#     range here. Otherwise every request appears to come from the proxy, and all users share a
#     single rate-limit bucket: a handful of bad logins would block login for everyone.
#   - On Render: requests go Cloudflare -> Render load balancer (10.x) -> a proxy inside the
#     instance, and that proxy is what connects to this app, over loopback. Use 127.0.0.1/32.
#     Render doesn't document this; it was confirmed by logging req.socket.remoteAddress, so
#     re-check that way if the rate limiter starts treating all users as one. Do NOT add
#     Cloudflare's, Render's 10.x or Vercel's ranges: none of them connects to this app directly.
#   - Cloudflare in front of your OWN server (it connects to you directly): list
#     https://www.cloudflare.com/ips-v4 and ips-v6.
#   - Exposed directly to the internet, leave it EMPTY: a trusted header lets any client choose
#     its own rate-limit bucket.
TRUSTED_PROXY_CIDRS=

# BullMQ dashboard at /admin/queues. Its job payloads contain password-reset and verification
# tokens, so it stays off unless switched on here, and needs credentials when on.
ENABLE_QUEUE_DASHBOARD=false
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for the local docker Redis; set for a hosted one (e.g. Redis Cloud). A hosted
# database must use the `noeviction` policy, or BullMQ warns and can lose jobs.
REDIS_USERNAME=
REDIS_PASSWORD=

# Response cache — a SEPARATE Redis (docker-compose service `redis-cache`, port 6380). It must be
# allowed to evict (volatile-lru) while the instance above must never evict, or BullMQ loses jobs.
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6380
# Default to REDIS_USERNAME / REDIS_PASSWORD when unset.
CACHE_REDIS_USERNAME=
CACHE_REDIS_PASSWORD=
# Set to false to bypass the cache entirely (every read goes to MongoDB).
CACHE_ENABLED=true
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UV_THREADPOOL_SIZE=12
RAZORPAY_KEY_ID=
# Razorpay webhook signing secret. Register https://<your-api-host>/webhooks/razorpay in the
# Razorpay dashboard for the payment.captured and order.paid events, and paste its secret here.
# Required in production: without it a payment whose customer closed the tab never becomes an order.
RAZORPAY_WEBHOOK_SECRET=

# Storefront origin used for links inside emails. Defaults to the first entry of CORS_ORIGIN.
CLIENT_URL=http://localhost:5173

RAZORPAY_KEY_SECRET=

# Gmail API sender (separate Google Cloud project from Google sign-in). One-time setup: start the
# server, open http://localhost:5000/api/auth/gmail as noreply.gvprojects@gmail.com, then paste the
# refresh token printed in the server console into GMAIL_REFRESH_TOKEN and restart.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
# Optional display name shown next to noreply.gvprojects@gmail.com.
GMAIL_SENDER_NAME=
# Authorization routes are always on outside production; set true only while re-authorizing in production.
GMAIL_OAUTH_SETUP=false
